# Copy this file to .env
# Required
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
NODE_ENV=development
PORT=3000

# Database (defaults are used if missing)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=employees
DB_SSL=false
FRONTEND_URL=http://localhost:5173
AUTO_INIT_SCHEMA=true
COOKIE_SAME_SITE=strict
# Set these only temporarily when running npm run create-admin.
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Or use a complete hosted PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/employees
